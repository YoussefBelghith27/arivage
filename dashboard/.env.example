# Copy to .env (never commit .env). Required on the very first start only: creates the two accounts.
ADMIN_PASSWORD=change-me-youssef
RESELLER_PASSWORD=change-me-aziz
# Optional
PORT=3001
DB_PATH=server/data/stock.db
# In production (hosting): NODE_ENV=production
# Optional: "Se connecter avec Google". OAuth Client ID (Web) from console.cloud.google.com
GOOGLE_CLIENT_ID=
# Optional: lockout after 5 failed logins, in ms (default 900000 = 15 min). Use 10000 to test.
# LOGIN_WINDOW_MS=10000
